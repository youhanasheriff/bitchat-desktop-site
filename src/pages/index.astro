---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { release, linuxRelease, windowsRelease, repository } from '../data/release';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const asset = (path: string) => base + path;
const canonical = new URL(base, Astro.site);
const [sizeWhole, sizeFraction] = release.size.replace(' MB', '').split('.');
const themes = [
  { id: 'light', label: 'Daylight', file: 'light-bubbles.png', icon: 'sun', description: 'Light theme · Bubble chat' },
  { id: 'terminal', label: 'Terminal', file: 'terminal.png', icon: 'terminal', description: 'Terminal theme · Terminal chat' },
  { id: 'graphite', label: 'Graphite', file: 'graphite.png', icon: 'moon', description: 'Graphite theme · Bubble chat' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f7f7ef" />
  <title>BitChat Desktop — A little closer. Even offline.</title>
  <meta name="description" content="BitChat, with room to breathe. A native, open-source desktop chat app with Bluetooth mesh, Bubble and Terminal layouts, and a small footprint. macOS early preview and Windows and Linux Bluetooth discovery previews available." />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="BitChat Desktop — A little closer. Even offline." />
  <meta property="og:description" content="Native desktop chat. Open source. Made to connect. Try the macOS early preview or Windows and Linux discovery previews." />
  <meta property="og:url" content={canonical} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:image" content={new URL(asset('social-card.png'), Astro.site)} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href={base} aria-label="BitChat Desktop home"><img src={asset('favicon.svg')} width="35" height="35" alt="" /><span>BitChat<span class="brand-desktop"> Desktop</span></span></a>
    <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false" aria-label="Open navigation"><span></span><span></span></button>
    <nav id="main-nav" aria-label="Main navigation">
      <a href="#experience">The app</a><a href="#how-it-works">How it works</a><a href={repository} class="source-nav">GitHub <span aria-hidden="true">↗</span></a><a class="nav-download" href="#download">Get the preview <Icon name="arrow" size={16}/></a>
    </nav>
  </header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-intro">
        <a class="preview-pill" href="#download"><span class="status-dot"></span> A small app. A new connection. <span class="pill-label">Early preview <span aria-hidden="true">↗</span></span></a>
        <div class="hero-title-wrap"><h1 id="hero-title">A little closer.<br/><span class="underlined">Even offline.<svg viewBox="0 0 600 22" preserveAspectRatio="none" aria-hidden="true"><path d="M4 13C130 0 344 0 594 9M45 20C229 10 389 12 527 16"/></svg></span></h1>
          <div class="margin-note hero-note">less scrolling,<br/>more connecting<svg viewBox="0 0 120 75" aria-hidden="true"><path d="M110 4C113 57 64 72 14 45m14-3-15 3 6 14"/></svg></div>
        </div>
        <p class="hero-description">BitChat, with room to breathe. A native desktop app for conversations nearby — and a little further afield.</p>
        <div class="hero-actions"><a class="button button-primary" href="#download"><Icon name="download"/> Explore the downloads <span aria-hidden="true">↗</span></a><a class="text-link" href={repository}>Explore the source <Icon name="arrow" size={18}/></a></div>
        <p class="hero-meta">Free & open source <span>·</span> No account needed <span>·</span> Windows & Linux discovery previews available</p>
      </div>
      <div class="product-stage" id="experience">
        <div class="stage-caption"><span class="tiny-label">YOUR CHAT. YOUR KIND OF QUIET.</span><div class="theme-tabs" role="group" aria-label="Choose an app screenshot">{themes.map((theme, index) => <button class:list={['theme-tab', { active: index === 0 }]} data-theme={theme.id} aria-pressed={index === 0} aria-controls="app-screenshot"><Icon name={theme.icon} size={15}/><span>{theme.label}</span></button>)}</div></div>
        <figure class="app-figure">
          <div class="screenshot-wrap" id="app-screenshot">{themes.map((theme, index) => <img class:list={['app-screenshot', { selected: index === 0 }]} data-screenshot={theme.id} src={asset('screenshots/' + theme.file)} width="2240" height="1680" alt={`BitChat Desktop native macOS app: ${theme.description}, showing a sample conversation and the people and channels sidebar.`} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} hidden={index !== 0}/>)}</div>
          <figcaption><span><span class="live-mark"></span> Actual native macOS app <span class="caption-separator">/</span> Sample conversation</span><span id="theme-caption" aria-live="polite">Light theme · Bubble chat</span></figcaption>
        </figure>
        <div class="stage-note margin-note">looks like home.<br/>because it is.<svg viewBox="0 0 92 72" aria-hidden="true"><path d="M4 64C58 67 75 38 73 7m-9 11L73 5l13 12"/></svg></div>
      </div>
      <div class="principles"><span><Icon name="mesh" size={18}/> Bluetooth mesh</span><span><Icon name="globe" size={18}/> Nostr location channels</span><span><Icon name="code" size={18}/> Open source, always</span><span><Icon name="heart" size={18}/> Native by design</span></div>
    </section>
    <section class="connection section" id="how-it-works" aria-labelledby="connection-title">
      <div class="section-heading"><p class="eyebrow">GOOD CONVERSATIONS FIND A WAY</p><h2 id="connection-title">The network is<br/><span class="serif-accent">the people around you.</span></h2><p>On a train. At a meetup. Somewhere the Wi-Fi isn't.<br class="desktop-break"/> Nearby devices can connect over Bluetooth and relay messages through the mesh.</p></div>
      <div class="connection-content">
        <div class="mesh-illustration" role="img" aria-label="Illustration of four nearby devices connected in a Bluetooth mesh. The range and routes shown are illustrative.">
          <div class="mesh-grid"></div>
          <svg class="mesh-lines" viewBox="0 0 570 360" aria-hidden="true"><path class="mesh-path" d="M105 115Q180 80 285 190T477 100M285 190Q192 233 137 287M477 100Q480 257 371 300M137 287Q260 315 371 300"/><circle class="mesh-ring" cx="285" cy="190" r="100"/><circle class="mesh-ring ring-outer" cx="285" cy="190" r="157"/><circle class="travel-dot" cx="185" cy="119" r="4"/><circle class="travel-dot delay" cx="405" cy="176" r="4"/></svg>
          <div class="mesh-node node-you"><div class="device-laptop"><span>&gt; hello, nearby_</span></div><span class="node-label">you, at your desk</span></div>
          <div class="mesh-node node-one"><span class="avatar av-m">m</span><span class="node-label">Maya</span></div>
          <div class="mesh-node node-two"><span class="avatar av-j">j</span><span class="node-label">Jules</span></div>
          <div class="mesh-node node-three"><span class="avatar av-n">n</span><span class="node-label">Noor</span></div>
          <span class="mesh-label label-one">a little hello</span><span class="mesh-label label-two">finds its way</span><span class="diagram-caption">Illustrative mesh · device support and range vary</span>
        </div>
        <div class="connection-stories">
          <article><span class="story-number">01 / NEARBY</span><h3>No Wi-Fi? Stay in the conversation.</h3><p>Bluetooth mesh messaging is built to work without an internet connection. Other nearby peers can help a message travel further.</p></article>
          <article><span class="story-number">02 / FURTHER AFIELD</span><h3>A local feeling. A wider circle.</h3><p>Explore Nostr location channels over the internet. Switch between the mesh and a place, right from the sidebar.</p></article>
          <p class="technical-note">Built on upstream Bitchat technology. Desktop hardware and cross-device interoperability testing are still in progress.</p>
        </div>
      </div>
    </section>
    <section class="native-section section" aria-labelledby="native-title">
      <div class="native-intro"><p class="eyebrow">A DESKTOP APP THAT BELONGS HERE</p><h2 id="native-title">Small footprint.<br/>Plenty of personality.</h2><p>No bundled browser. No extra ceremony. Just native controls, a proper sidebar, and space for the conversation.</p><a class="text-link" href="#experience">Take a closer look <Icon name="arrow" size={18}/></a></div>
      <div class="native-details"><div class="size-detail"><span class="size-number">{sizeWhole}<span>.{sizeFraction}</span><small>MB DOWNLOAD</small></span><div><strong>A little app, on purpose.</strong><p>Compressed macOS early-preview DMG.<br/>Apple silicon. No bundled Chromium.</p></div><span class="size-scribble" aria-hidden="true">light on its feet <svg viewBox="0 0 100 40"><path d="M2 35Q63 50 85 9m-11 3 12-5 5 13"/></svg></span></div>
      <div class="feature-row"><span class="feature-icon"><Icon name="terminal" size={22}/></span><div><h3>Bubbles or a blinking-cursor mood.</h3><p>Choose Bubble or Terminal chat in Settings. Then pick a theme that feels like you.</p><button class="settings-preview-link" data-open-settings>Peek into Settings <span aria-hidden="true">↗</span></button></div></div>
      <div class="feature-row"><span class="feature-icon"><Icon name="shield" size={22}/></span><div><h3>A face. A name. A way to verify.</h3><p>Peer details and QR verification put identity checks within reach. Private messaging uses upstream Bitchat encryption.</p></div></div>
      <div class="feature-row"><span class="feature-icon"><Icon name="code" size={22}/></span><div><h3>Yours to inspect. Yours to build on.</h3><p>No account to create. Free to use. Open source under the MIT License. Read the code, report a bug, or make it your own.</p></div></div></div>
    </section>
    <section class="linux-section section" id="linux" aria-labelledby="linux-title">
      <div class="linux-intro">
        <p class="eyebrow">A FIRST STEP ON LINUX</p>
        <h2 id="linux-title">Hello, nearby.<br/><span class="serif-accent">Now from Linux.</span></h2>
        <p>A native GTK4 window. A Bluetooth scan. A small beginning for the Linux desktop.</p>
        <p>Find devices advertising the Bitchat service, or run a scan from your terminal. Choose a build for Intel/AMD or ARM64.</p>
        <p class="linux-scope"><strong>Discovery only.</strong> Messaging and verified peer identities are still ahead. Physical Bluetooth interoperability is not yet qualified.</p>
        <a class="text-link" href="#linux-download">Try the Linux discovery preview <Icon name="arrow" size={18}/></a>
      </div>
      <figure class="linux-figure">
        <img src={asset('screenshots/linux-discovery.png')} width="900" height="600" loading="lazy" alt="Actual BitChat Desktop Linux GTK4 window, ready to scan for nearby devices on Mainnet. No devices or conversations are shown."/>
        <figcaption>Actual native GTK4 app · Debian 12 · Ready to scan</figcaption>
      </figure>
    </section>
    <section class="linux-section section windows-section" id="windows" aria-labelledby="windows-title">
      <div class="linux-intro">
        <p class="eyebrow">A FIRST STEP ON WINDOWS</p>
        <h2 id="windows-title">A familiar window.<br/><span class="serif-accent">A new beginning.</span></h2>
        <p>Native Windows controls, a nearby-device list, and a Bluetooth scan. Open the app or explore from PowerShell.</p>
        <p class="linux-scope"><strong>Discovery only.</strong> Find devices advertising the Bitchat service. Messaging and verified identities are still ahead, and physical Bluetooth interoperability is not yet qualified.</p>
        <a class="text-link" href="#windows-download">Try the Windows discovery preview <Icon name="arrow" size={18}/></a>
      </div>
      <figure class="linux-figure">
        <img src={asset('screenshots/windows-discovery.png')} width="940" height="650" loading="lazy" alt="Actual native BitChat Desktop Windows discovery window, ready to scan. No devices or conversations are shown."/>
        <figcaption>Actual Win32 app · Windows CI desktop · Ready to scan</figcaption>
      </figure>
    </section>
    <section class="download-section section" id="download" aria-labelledby="download-title">
      <div class="download-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="download-heading"><span class="light-pill"><span class="status-dot"></span> SMALL BEGINNINGS. OPEN POSSIBILITIES.</span><h2 id="download-title">Make room for<br/>a good conversation.</h2><p>Three native desktops. The macOS early preview and<br/>Windows & Linux discovery previews are here.<br/>Choose your platform. Help shape what comes next.</p></div>
      <div class="download-platforms"><article class="platform-download mac-download"><div class="platform-heading"><svg width="28" height="32" viewBox="0 0 24 28" fill="currentColor" aria-hidden="true"><path d="M16.8 0c.2 2-1 4-2.2 5.2-1.2 1.1-2.8 1.8-4.4 1.6-.2-1.8.7-3.8 1.9-5C13.4.5 15.3.1 16.8 0ZM22 20.8c-.6 1.4-.9 2-1.7 3.3-1.1 1.7-2.7 3.8-4.6 3.8-1.7 0-2.2-1.1-4.5-1.1-2.2 0-2.8 1.1-4.5 1.1-1.9 0-3.3-1.9-4.4-3.6C-.8 19.5-1 12.8 1 9.3 2.5 6.8 5 6 7 6c2.1 0 3.4 1.1 5.1 1.1 1.6 0 2.7-1.1 5.1-1.1 1.8 0 3.7 1 5 2.7-4.4 2.4-3.7 8.7.8 10.5l-1 1.6Z"/></svg><h3>Made for your Mac.</h3><span class="early-label">EARLY PREVIEW</span></div><p>{release.requirements} <span>·</span> {release.version}</p><a class="button download-button" href={release.url}><Icon name="download"/> Download for macOS <Icon name="arrow" size={18}/></a><p class="release-links"><a href={release.zipUrl}>ZIP alternative</a><span aria-hidden="true"> · </span><a href={release.notesUrl}>Release notes & checksums <span aria-hidden="true">↗</span></a></p><p class="preview-disclosure">{release.signing} Review the <a href="#installation">first-open instructions</a> before installing. This is preview software; features and compatibility are still being tested.</p></article><article class="platform-download linux-download" id="linux-download">
          <div class="platform-heading"><Icon name="terminal" size={24}/><h3>Start exploring Linux.</h3><span class="early-label">DISCOVERY PREVIEW</span></div>
          <p>Intel/AMD 64-bit or ARM64 <span>·</span> {linuxRelease.version}</p>
          <p class="linux-download-scope">{linuxRelease.scope}</p>
          <a class="button download-button" href={linuxRelease.x86Url}><Icon name="download"/> Linux · Intel / AMD 64-bit <Icon name="arrow" size={18}/></a>
          <a class="button download-button" href={linuxRelease.armUrl}><Icon name="download"/> Linux · ARM64 <Icon name="arrow" size={18}/></a>
          <p class="release-links"><a href={linuxRelease.notesUrl}>Linux release notes & checksums <span aria-hidden="true">↗</span></a></p>
          <p class="preview-disclosure">{linuxRelease.requirements}. Unsigned .tar.gz archives; system libraries are installed separately. Read the <a href="#linux-installation">Linux setup instructions</a>. Hardware testing is still in progress.</p>
        </article><article class="platform-download windows-download" id="windows-download">
          <div class="platform-heading"><span class="windows-mark" aria-hidden="true">⊞</span><h3>Hello, Windows.</h3><span class="early-label">DISCOVERY PREVIEW</span></div>
          <p>{windowsRelease.requirements} <span>·</span> {windowsRelease.version}</p>
          <p class="linux-download-scope">{windowsRelease.scope}</p>
          <a class="button download-button" href={windowsRelease.url}><Icon name="download"/> Windows · Intel / AMD 64-bit <Icon name="arrow" size={18}/></a>
          <p class="release-links"><a href={windowsRelease.notesUrl}>Windows release notes & checksums <span aria-hidden="true">↗</span></a></p>
          <p class="preview-disclosure">Unsigned ZIP with a native app and terminal scanner. Extract it, then open the app. See the <a href="#windows-installation">Windows setup instructions</a>. Physical Bluetooth testing is still in progress.</p>
        </article></div>
        <p class="download-project-link"><a href={repository} class="roadmap-link">Follow the project on GitHub <Icon name="arrow" size={17}/></a></p>
    </section>
    <section class="faq-section section" aria-labelledby="faq-title"><div><p class="eyebrow">A FEW THINGS TO KNOW</p><h2 id="faq-title">Good questions.<br/>Straight answers.</h2><span class="faq-doodle" aria-hidden="true">?</span></div><div class="faq-list">
      <details><summary>Is this the official Bitchat app?<Icon name="plus" size={20}/></summary><p>No. BitChat Desktop is an independent, open-source project by Youhana Sheriff, following the work of <a href="https://github.com/permissionlesstech/bitchat">permissionlesstech/bitchat</a>. It brings a desktop-focused experience to that foundation and is not an official upstream release.</p></details>
      <details><summary>Does it really work without the internet?<Icon name="plus" size={20}/></summary><p>The Bluetooth mesh transport is designed for nearby communication without internet access. It needs compatible, available Bluetooth hardware and other peers within reach. Nostr location channels use the internet. Real-device interoperability testing is still underway. These messaging features belong to the macOS preview; the Windows and Linux previews only discover Bluetooth devices.</p></details>
      <details><summary>Which computers can run the preview?<Icon name="plus" size={20}/></summary><p>The macOS early preview is for Apple silicon Macs. Linux discovery previews are available for Intel/AMD 64-bit and ARM64 systems with GTK 4.8+, glibc 2.36+, and BlueZ. Windows discovery is available for Intel/AMD 64-bit PCs, with Windows 11 recommended. Windows and Linux messaging is not implemented yet. See each platform’s release notes for installation requirements and tested environments.</p></details>
      <details id="installation"><summary>How do I open the macOS early preview?<Icon name="plus" size={20}/></summary><p>Open the downloaded DMG and drag BitChat Desktop into Applications. Eject the disk image, then launch the app from Applications. This preview is ad-hoc signed and is not notarized by Apple, so macOS may block its first launch.</p><p>If you trust the download, open System Settings → Privacy & Security and use <strong>Open Anyway</strong> for this specific app. Follow Apple's confirmation prompts. See <a href="https://support.apple.com/en-us/102445">Apple's guidance</a> and the <a href={release.notesUrl}>release notes</a>. Do not disable system-wide security settings.</p></details>
      <details id="linux-installation"><summary>How do I run the Linux discovery preview?<Icon name="plus" size={20}/></summary><p>Choose the archive matching your computer: Intel/AMD 64-bit (x86_64) or ARM64 (aarch64). Verify its SHA-256 checksum, extract it, then run <code>./bitchat-desktop</code> from the extracted directory. Use <code>./bitchat-desktop --scan --seconds 15</code> for a terminal scan.</p><p>Install GTK and Bluetooth runtime dependencies through your distribution, then enable Bluetooth in system settings. The <a href={linuxRelease.notesUrl}>Linux release notes</a> include Debian 12 and Ubuntu 24.04 package commands. Run as your normal user. This unsigned discovery preview does not send messages or join the mesh.</p></details>
      <details id="windows-installation"><summary>How do I run the Windows discovery preview?<Icon name="plus" size={20}/></summary><p>Download the Intel/AMD 64-bit ZIP, verify its SHA-256 checksum, and extract the entire archive. Open <code>bitchat-desktop-windows.exe</code>, enable Bluetooth in Windows Settings, then select Start scan. For PowerShell, run <code>.\bitchat-scan.exe --scan --seconds 15</code> from the extracted folder.</p><p>This preview is unsigned, so Windows may show a SmartScreen warning. Review the <a href={windowsRelease.notesUrl}>release notes, source, and checksum</a> before deciding whether to run it. Windows 11 is recommended; Windows 10 22H2 is the API baseline. CI runs on Windows Server 2025; physical Windows 10/11 and Bluetooth qualification remain open. No administrator rights or separate runtime installation is required.</p></details>
      <details><summary>Are the screenshots from the real app?<Icon name="plus" size={20}/></summary><p>Yes. The chat screenshots capture the native macOS interface with fictitious sample conversations. The Linux screenshot captures the real GTK4 discovery window running on Debian 12 under a virtual display, without Bluetooth hardware. The Windows screenshot captures the real Win32 window on a GitHub-hosted Windows CI desktop, without verified Bluetooth hardware. The sample messages illustrate the UI, not a verified live mesh session. Bubble and Terminal layouts and the themes shown are implemented in the app.</p></details>
      <details><summary>How can I help?<Icon name="plus" size={20}/></summary><p>Try the preview, share reproducible issues, help test real devices, or contribute to the code and platform work. <a href={repository + '/issues'}>Issues and contributions</a> are welcome. There is no account or mailing list required to download the app.</p></details>
    </div></section>
    <section class="closing"><span class="little-star" aria-hidden="true">✳</span><p>Built in the open.<br/><span>Better with you in it.</span></p><a class="text-link" href={repository}>Come say hello on GitHub <Icon name="arrow" size={19}/></a></section>
  </main>
  <footer class="site-footer"><div><a class="brand" href={base}><img src={asset('favicon.svg')} width="30" height="30" alt=""/><span>BitChat Desktop</span></a><p>An independent desktop project by <a href="https://youhanasheriff.com">Youhana Sheriff</a> · <a href="https://github.com/youhanasheriff" aria-label="Youhana Sheriff on GitHub">GitHub ↗</a><br/>With thanks to the upstream Bitchat contributors.</p></div><div class="footer-links"><a href={repository}>Source code ↗</a><a href={repository + '/issues'}>Report an issue ↗</a><a href="https://github.com/permissionlesstech/bitchat">Upstream Bitchat ↗</a><a href={repository + "/blob/main/LICENSE"}>Open source · MIT License ↗</a></div><p class="footer-bottom">A little less infrastructure. A little more human.<span>No analytics. No tracking cookies.</span></p></footer>
  <dialog id="settings-dialog" aria-labelledby="settings-dialog-title"><div class="dialog-header"><div><h2 id="settings-dialog-title">A little more you.</h2><p>Actual native Settings · appearance preferences</p></div><button class="dialog-close" data-close-settings aria-label="Close settings preview">×</button></div><img src={asset('screenshots/settings.png')} width="1240" height="1520" loading="lazy" alt="Native BitChat Desktop Settings showing Terminal, Native Light, Graphite and Liquid Glass theme options, and Terminal or Bubble chat style."/></dialog>
  <script>
    const settingsDialog = document.querySelector<HTMLDialogElement>('#settings-dialog');
    document.querySelector('[data-open-settings]')?.addEventListener('click', () => settingsDialog?.showModal());
    document.querySelector('[data-close-settings]')?.addEventListener('click', () => settingsDialog?.close());
    settingsDialog?.addEventListener('click', event => { if (event.target === settingsDialog) { const bounds = settingsDialog.getBoundingClientRect(); if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) settingsDialog.close(); } });
    const descriptions: Record<string, string> = { light: 'Light theme · Bubble chat', terminal: 'Terminal theme · Terminal chat', graphite: 'Graphite theme · Bubble chat' };
    const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme]');
    themeButtons.forEach(button => button.addEventListener('click', () => {
      const theme = button.dataset.theme ?? 'light';
      themeButtons.forEach(item => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-pressed', String(active)); });
      document.querySelectorAll<HTMLImageElement>('[data-screenshot]').forEach(img => { const active = img.dataset.screenshot === theme; img.hidden = !active; img.classList.toggle('selected', active); });
      const caption = document.getElementById('theme-caption');
      if (caption) caption.textContent = descriptions[theme];
    }));
    const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('#main-nav');
    const closeMenu = () => { menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Open navigation'); nav?.classList.remove('open'); };
    menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); menu.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation'); nav?.classList.toggle('open', open); });
    nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
    document.querySelectorAll<HTMLAnchorElement>('a[href="#installation"], a[href="#linux-installation"], a[href="#windows-installation"]').forEach(link => link.addEventListener('click', () => { const detail = document.querySelector<HTMLDetailsElement>(link.hash); if (detail) detail.open = true; }));
  </script>
</body>
</html>
